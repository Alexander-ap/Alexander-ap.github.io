---
layout: base
---
<%
  function plainText(html) {
    return strip_html(html || '')
      .replace(/&nbsp;/g, ' ')
      .replace(/&quot;|&#34;/g, '"')
      .replace(/&#39;|&apos;/g, "'")
      .replace(/&lt;/g, '<')
      .replace(/&gt;/g, '>')
      .replace(/&amp;/g, '&')
      .replace(/\s+/g, ' ')
      .trim();
  }
  function makeBrief(post) {
    var raw = (post.excerpt && post.excerpt.trim().length > 0) ? post.excerpt : (post.content || '');
    if (!post.excerpt || post.excerpt.trim().length === 0) {
      var cut = raw.search(/<h[2-6][\s>]/i);
      if (cut > 0) raw = raw.slice(0, cut);
    }
    var text = plainText(raw.replace(/<pre[\s\S]*?<\/pre>/gi, ' ').replace(/<figure[\s\S]*?<\/figure>/gi, ' '));
    return text.length > 130 ? text.slice(0, 130) + '…' : text;
  }
  function readTime(post) {
    return Math.max(1, Math.round(plainText(post.content).length / 300));
  }
  function wordCount(post) {
    return plainText(post.content).length;
  }
%>

<section class="intro">
  <% (theme.intro_lines || []).forEach(function (line) { %>
    <% if (line) { %><p class="line"><%= line %></p><% } %>
  <% }); %>

  <% if (theme.social) { %>
    <div class="social">
      <% Object.keys(theme.social).forEach(function (name) { %>
        <% if (theme.social[name]) { %>
          <a href="<%- theme.social[name] %>" title="<%= name %>" aria-label="<%= name %>"><%- partial('_partial/icon', { name: name }) %></a>
        <% } %>
      <% }); %>
    </div>
  <% } %>

  <div class="filter-row">
    <div class="chips">
      <a class="chip active" href="<%- url_for('/') %>">全部</a>
      <% if (theme.show_category_chips !== false) { %>
        <% site.categories.each(function (cat) { %>
          <a class="chip" href="<%- url_for(cat.path) %>"><%= cat.name %></a>
        <% }); %>
      <% } %>
    </div>
    <span class="note-count"><%= site.posts.length %> notes</span>
  </div>
</section>

<section class="post-list">
  <% page.posts.each(function (post) { %>
    <% var cat = (post.categories && post.categories.length) ? post.categories.toArray()[0].name : ''; %>
    <article class="row">
      <a class="row-inner" href="<%- url_for(post.path) %>">
        <div class="datecol">
          <span class="md"><%= date(post.date, 'MM.DD') %></span>
          <span class="ym"><%= date(post.date, 'YYYY') %><%= cat ? ' · ' + cat : '' %></span>
        </div>
        <div class="body">
          <div class="title-line">
            <h2><%= post.title %></h2>
            <span class="read-hint">阅读 →</span>
          </div>
          <p class="excerpt"><%= makeBrief(post) %></p>
          <div class="meta"><%= date(post.date, 'YYYY年M月D日') %> · <%= readTime(post) %> 分钟 · <%= wordCount(post) %> 字</div>
        </div>
      </a>
    </article>
  <% }); %>
</section>

<% if (page.total > 1) { %>
  <nav class="pager">
    <% if (page.prev) { %><a href="<%- url_for(page.prev_link) %>">← 更新</a><% } %>
    <span><%= page.current %> / <%= page.total %></span>
    <% if (page.next) { %><a href="<%- url_for(page.next_link) %>">更早 →</a><% } %>
  </nav>
<% } %>
