<!doctype html>
<html lang="zh-CN">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <% var siteTitle = config.title || 'Blog'; %>
  <% var assetVer = theme.asset_version || '1'; %>
  <% var docTitle = (typeof page !== 'undefined' && page && page.title) ? page.title + ' · ' + siteTitle : siteTitle; %>
  <title><%= docTitle %></title>
  <%
    // 摘要优先级：front-matter 的 description → 正文摘要 → 站点描述
    var seoDesc = String((page && page.description) || '').trim();
    if (!seoDesc) seoDesc = excerpt_text(page, 110);
    if (!seoDesc) seoDesc = config.description || '';
    seoDesc = seoDesc.replace(/\s+/g, ' ').trim();
    if (seoDesc.length > 150) seoDesc = seoDesc.slice(0, 150) + '…';
    // 去掉 index.html 后缀，canonical 与 og:url 用干净路径
    var seoUrl = full_url_for(page.path).replace(/index\.html$/, '');
  %>
  <link rel="canonical" href="<%= seoUrl %>">
  <meta name="robots" content="index,follow,max-image-preview:large">
  <%- open_graph({
        url: seoUrl,
        description: seoDesc,
        type: is_post() ? 'article' : 'website',
        twitter_card: 'summary'
      }) %>
  <link rel="icon" href="<%- url_for('/images/favicon.svg') %>">
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link rel="stylesheet" media="print" onload="this.media='all'"
        href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:ital,wght@0,500;0,600;1,400&family=Noto+Serif+SC:wght@400;500;600&family=Noto+Sans+SC:wght@400;500&display=swap">
  <link rel="stylesheet" href="<%- url_for('/css/theme.css') %>?v=<%= assetVer %>">
  <% if (is_post()) { %>
  <script type="application/ld+json">
  <%- JSON.stringify({
        '@context': 'https://schema.org',
        '@type': 'BlogPosting',
        headline: page.title,
        datePublished: page.date.toISOString(),
        dateModified: (page.updated || page.date).toISOString(),
        description: seoDesc,
        inLanguage: 'zh-CN',
        mainEntityOfPage: { '@type': 'WebPage', '@id': seoUrl },
        author: { '@type': 'Person', name: config.author },
        publisher: { '@type': 'Organization', name: config.title },
        keywords: (page.tags && page.tags.length)
          ? page.tags.toArray().map(function (t) { return t.name; }).join(',')
          : ''
      }).replace(/<\//g, '<\\/') %>
  </script>
  <% } %>
</head>
<body>
  <div class="topline"></div>
  <div class="readbar" hidden></div>

  <div class="wrap">
    <%
      var initial = theme.avatar_initial || (siteTitle || 'A').trim().charAt(0);
      var cur = (typeof page !== 'undefined' && page && page.path) ? page.path : '';
      function isActive(url) {
        if (url === '/') return is_home() ? ' active' : '';
        return cur.indexOf(url.replace(/^\//, '')) === 0 ? ' active' : '';
      }
    %>
    <header class="site">
      <a class="brand" href="<%- url_for('/') %>">
        <span class="avatar"><%= initial %></span>
        <span class="brand-text">
          <span class="name"><%= siteTitle %><i>.</i></span>
          <% if (theme.tagline) { %><span class="tagline"><%= theme.tagline %></span><% } %>
        </span>
      </a>

      <nav class="pills">
        <% (theme.nav || []).forEach(function (item) { %>
          <a class="pill<%= isActive(item.url) %>" href="<%- url_for(item.url) %>"><%= item.label %></a>
        <% }); %>
        <button class="pill pill-search" type="button" data-search-trigger
                data-src="<%- url_for('/search.xml') %>" hidden>搜索</button>
      </nav>
    </header>

    <main>
      <%- body %>
    </main>

    <footer class="site">
      <div class="foot-left"><span class="dot"></span>© <%= date(new Date(), 'YYYY') %> <%= siteTitle %></div>
      <div class="foot-right">
        <a href="<%- url_for('/archives/') %>">归档</a>
        <a href="<%- url_for('/atom.xml') %>">RSS 订阅</a>
        <a href="<%- url_for('/about/') %>">写信给我</a>
      </div>
    </footer>
  </div>
  <script src="<%- url_for('/js/theme.js') %>?v=<%= assetVer %>" defer></script>
</body>
</html>
