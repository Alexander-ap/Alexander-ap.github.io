---
layout: base
---
<article class="post">
  <a class="back" href="<%- url_for('/') %>"><span>←</span> 返回目录</a>

  <div class="post-meta">
    <% if (page.categories && page.categories.length) { %>
      <span class="tag"><%= page.categories.toArray()[0].name %></span>
    <% } %>
    <time><%= date(page.date, 'YYYY.MM.DD') %></time>
    <span class="slash">/</span>
    <span><%= read_time(page) %> 分钟阅读</span>
    <span class="slash">/</span>
    <span><%= word_count(page) %> 字</span>
  </div>

  <h1 class="post-title"><%= page.title %></h1>

  <% var tocHtml = toc(page.content, { min_depth: 2, max_depth: 3, list_number: false }); %>
  <% if (tocHtml) { %>
    <nav class="toc-card" aria-label="目录">
      <p class="toc-title">目录</p>
      <div class="toc-body"><%- tocHtml %></div>
    </nav>
  <% } %>

  <div class="content"><%- page.content %></div>

  <% if (page.tags && page.tags.length) { %>
    <div class="post-tags">
      <% page.tags.each(function (tag) { %>
        <a class="chip" href="<%- url_for(tag.path) %>">#<%= tag.name %></a>
      <% }); %>
    </div>
  <% } %>

  <div class="signoff">
    <span>写于 <%= date(page.date, 'YYYY.MM.DD') %><%= theme.city ? ' · ' + theme.city : '' %></span>
    <span class="thanks">Thanks for reading.</span>
  </div>

  <div class="post-nav">
    <% if (page.prev) { %>
      <a class="nav-card" href="<%- url_for(page.prev.path) %>">
        <span class="label">← 较新的一篇</span>
        <span class="t"><%= page.prev.title %></span>
      </a>
    <% } else { %><div></div><% } %>
    <% if (page.next) { %>
      <a class="nav-card right" href="<%- url_for(page.next.path) %>">
        <span class="label">较早的一篇 →</span>
        <span class="t"><%= page.next.title %></span>
      </a>
    <% } %>
  </div>
</article>
