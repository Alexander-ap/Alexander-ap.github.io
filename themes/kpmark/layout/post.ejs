---
layout: base
---
<article class="post">
  <a class="back" href="<%- url_for('/') %>"><span>←</span> 返回目录</a>

  <div class="post-meta">
    <% if (page.categories && page.categories.length) { %>
      <span class="tag"><%= page.categories.toArray()[0].name %></span>
    <% } %>
    <time><%= date(page.date, 'YYYY.MM.DD') %></time>
    <span class="slash">/</span>
    <span><%= read_time(page) %> 分钟阅读</span>
    <span class="slash">/</span>
    <span><%= word_count(page) %> 字</span>
  </div>

  <h1 class="post-title"><%= page.title %></h1>

  <% var tocHtml = toc(page.content, { min_depth: 2, max_depth: 3, list_number: false }); %>
  <% if (tocHtml) { %>
    <nav class="toc-card" aria-label="目录">
      <p class="toc-title">目录</p>
      <div class="toc-body"><%- tocHtml %></div>
    </nav>
  <% } %>

  <div class="content"><%- page.content %></div>

  <% if (page.tags && page.tags.length) { %>
    <div class="post-tags">
      <% page.tags.each(function (tag) { %>
        <a class="chip" href="<%- url_for(tag.path) %>">#<%= tag.name %></a>
      <% }); %>
    </div>
  <% } %>

  <div class="signoff">
    <span>写于 <%= date(page.date, 'YYYY.MM.DD') %><%= theme.city ? ' · ' + theme.city : '' %></span>
    <span class="thanks">Thanks for reading.</span>
  </div>

  <% if (page.copyright !== false) { %>
    <div class="post-license">
      <p>本文作者 <a href="<%- url_for('/about/') %>"><%= config.author %></a>，首发于 <a href="<%- full_url_for(page.path) %>"><%= config.title %></a>。</p>
      <p>采用 <a href="https://creativecommons.org/licenses/by-nc-sa/4.0/deed.zh" target="_blank" rel="noopener noreferrer">CC BY-NC-SA 4.0</a> 许可，转载请注明出处。</p>
    </div>
  <% } %>

  <% if (theme.donate && theme.donate.enabled && (theme.donate.wechat_qr || theme.donate.alipay_qr)) { %>
    <details class="donate">
      <summary>💰 赞赏支持</summary>
      <div class="donate-body">
        <% if (theme.donate.wechat_qr) { %>
          <figure><img src="<%- url_for(theme.donate.wechat_qr) %>" alt="微信赞赏"><figcaption>微信</figcaption></figure>
        <% } %>
        <% if (theme.donate.alipay_qr) { %>
          <figure><img src="<%- url_for(theme.donate.alipay_qr) %>" alt="支付宝赞赏"><figcaption>支付宝</figcaption></figure>
        <% } %>
      </div>
    </details>
  <% } %>

  <% if (theme.newsletter && theme.newsletter.enabled && theme.newsletter.buttondown) { %>
    <div class="subscribe-card">
      <p>📬 喜欢这篇文章？订阅邮件更新，新文发布时通知你。</p>
      <form class="subscribe-form" action="https://buttondown.email/api/emails/embed-subscribe/<%= theme.newsletter.buttondown %>" method="post">
        <input type="email" name="email" placeholder="你的邮箱" required>
        <button type="submit">订阅</button>
      </form>
    </div>
  <% } %>

  <div class="post-nav">
    <% if (page.prev) { %>
      <a class="nav-card" href="<%- url_for(page.prev.path) %>">
        <span class="label">← 较新的一篇</span>
        <span class="t"><%= page.prev.title %></span>
      </a>
    <% } else { %><div></div><% } %>
    <% if (page.next) { %>
      <a class="nav-card right" href="<%- url_for(page.next.path) %>">
        <span class="label">较早的一篇 →</span>
        <span class="t"><%= page.next.title %></span>
      </a>
    <% } %>
  </div>

  <% var related = related_posts(page, 3); %>
  <% if (related.length) { %>
    <section class="related">
      <h2 class="related-title">相关内容</h2>
      <ul class="plain-list">
        <% related.forEach(function (p) { %>
          <li>
            <span class="d"><%= date(p.date, 'YYYY.MM.DD') %></span>
            <a href="<%- url_for(p.path) %>"><%= p.title %></a>
          </li>
        <% }); %>
      </ul>
    </section>
  <% } %>
</article>

<% if (page.comments !== false && theme.giscus && theme.giscus.repo_id && theme.giscus.category_id) { %>
  <%
    var giscusTheme = theme.giscus.theme || 'light';
    if (giscusTheme.charAt(0) === '/') giscusTheme = full_url_for(giscusTheme);
  %>
  <section class="comments" id="comments">
    <h2 class="comments-title">留言</h2>
    <div class="giscus-slot"
         data-repo="<%= theme.giscus.repo %>"
         data-repo-id="<%= theme.giscus.repo_id %>"
         data-category="<%= theme.giscus.category || 'Comments' %>"
         data-category-id="<%= theme.giscus.category_id %>"
         data-mapping="<%= theme.giscus.mapping || 'pathname' %>"
         data-strict="0"
         data-reactions-enabled="<%= theme.giscus.reactions || '1' %>"
         data-emit-metadata="0"
         data-input-position="top"
         data-theme="<%= giscusTheme %>"
         data-lang="<%= theme.giscus.lang || 'zh-CN' %>"
         data-loading="lazy"></div>
  </section>
<% } %>
