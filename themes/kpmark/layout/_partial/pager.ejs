<% if (page.total && page.total > 1) { %>
  <nav class="pager">
    <% if (page.prev_link) { %><a href="<%- url_for(page.prev_link) %>">← 更新</a><% } else { %><span></span><% } %>
    <span><%= page.current %> / <%= page.total %></span>
    <% if (page.next_link) { %><a href="<%- url_for(page.next_link) %>">更早 →</a><% } %>
  </nav>
<% } %>
